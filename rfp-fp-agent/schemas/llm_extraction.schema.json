{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal/rfp-fp-agent/llm_extraction.schema.json",
  "title": "RFP FP Agent - LLM 구조화 출력 스키마 v0.2",
  "description": "LLM 은 이 스키마만 만족시키면 된다. FP/복잡도/가중치 필드는 존재하지 않는다 - 계산은 전적으로 Rule Engine 소관이다(설계원칙 1).",
  "type": "object",
  "required": ["document_id", "chunk_id", "requirements", "function_candidates"],
  "additionalProperties": false,
  "properties": {
    "document_id": { "type": "string" },
    "chunk_id": { "type": "string", "description": "재현성을 위한 입력 청크 식별자" },
    "model_fingerprint": {
      "type": "object",
      "description": "결과 재현/회귀 추적용. 모델 버전이 바뀌면 산정 결과가 흔들릴 수 있으므로 반드시 저장한다.",
      "required": ["model", "prompt_version", "temperature"],
      "properties": {
        "model": { "type": "string" },
        "prompt_version": { "type": "string" },
        "temperature": { "type": "number" },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["req_id", "title", "verbatim", "source"],
        "additionalProperties": false,
        "properties": {
          "req_id": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
          "rfp_req_code": {
            "type": ["string", "null"],
            "description": "RFP 원문에 이미 부여된 요구사항 번호(SFR-001 등). 없으면 null."
          },
          "title": { "type": "string", "maxLength": 200 },
          "verbatim": {
            "type": "string",
            "description": "RFP 원문 그대로. 요약/의역 금지. 추적성의 근간."
          },
          "business_area": { "type": ["string", "null"] },
          "requirement_class": {
            "type": "string",
            "enum": ["FUNCTIONAL", "NON_FUNCTIONAL", "MANAGEMENT", "CONSTRAINT", "OUT_OF_SCOPE"],
            "description": "비기능/관리 요구사항은 FP 산정 대상이 아니라 보정계수 입력으로 흘러간다."
          },
          "adjustment_signals": {
            "type": "array",
            "description": "보정계수 산정을 위한 신호(연계기관 수, 성능요건, 보안요건 등)",
            "items": {
              "type": "object",
              "required": ["factor", "signal", "source"],
              "properties": {
                "factor": {
                  "type": "string",
                  "enum": ["연계복잡성", "성능요구수준", "운영환경호환성", "보안성수준", "규모"]
                },
                "signal": { "type": "string" },
                "source": { "$ref": "#/$defs/source" }
              }
            }
          },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "function_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "requirement_ids", "name", "function_type", "evidence", "confidence", "status"],
        "additionalProperties": false,
        "properties": {
          "candidate_id": { "type": "string" },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "N:M. 요구사항 1건이 여러 기능으로 쪼개지고, 기능 1건이 여러 요구사항에 걸칠 수 있다."
          },
          "name": { "type": "string", "maxLength": 120 },
          "function_type": { "type": "string", "enum": ["ILF", "EIF", "EI", "EO", "EQ"] },
          "function_type_alternatives": {
            "type": "array",
            "description": "2순위 후보와 그 이유. 리뷰어가 EI/EO/EQ 경계 판단을 재검토할 때 사용.",
            "items": {
              "type": "object",
              "required": ["function_type", "why_not"],
              "properties": {
                "function_type": { "type": "string", "enum": ["ILF", "EIF", "EI", "EO", "EQ"] },
                "why_not": { "type": "string" }
              }
            }
          },
          "classification_rationale": {
            "type": "string",
            "description": "가이드 정의 문구에 근거한 판정 이유. 예: '내부논리파일을 갱신하지 않고 파생데이터 없음 → EQ'"
          },
          "unit_process_check": {
            "type": "object",
            "description": "단위프로세스 요건 충족 여부 자가검증. 미충족이면 FP 대상이 아니다.",
            "required": ["is_self_contained", "is_meaningful_to_user", "leaves_business_consistent"],
            "properties": {
              "is_self_contained": { "type": "boolean" },
              "is_meaningful_to_user": { "type": "boolean" },
              "leaves_business_consistent": { "type": "boolean" }
            }
          },
          "counts": {
            "type": "object",
            "description": "정통법 입력. 모르면 value=null + certainty=UNKNOWN. 절대 지어내지 않는다(원칙 4).",
            "properties": {
              "det": { "$ref": "#/$defs/counted" },
              "ret": { "$ref": "#/$defs/counted" },
              "ftr": { "$ref": "#/$defs/counted" }
            }
          },
          "referenced_data_functions": {
            "type": "array",
            "description": "이 트랜잭션이 참조하는 논리파일 이름들. Rule Engine 이 FTR 자동 도출 및 ILF/EIF 정합성 검증에 사용.",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "description": "근거는 필수. 근거 없는 기능은 스키마 단계에서 거부된다(원칙 3).",
            "items": { "$ref": "#/$defs/source" }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "status": {
            "type": "string",
            "enum": ["AI_PROPOSED", "NEED_REVIEW", "INSUFFICIENT_INFO", "OUT_OF_SCOPE_CANDIDATE"]
          },
          "open_questions": {
            "type": "array",
            "description": "발주자에게 되물어야 할 항목. 그대로 '확인요청 목록' 산출물이 된다.",
            "items": { "type": "string" }
          },
          "duplicate_of": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["page", "quote"],
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "section": { "type": ["string", "null"] },
        "quote": {
          "type": "string",
          "minLength": 5,
          "description": "원문에 문자 그대로 존재해야 한다. 서비스가 원문 대조로 검증하며, 불일치 시 hallucination 으로 간주하고 거부한다."
        },
        "bbox": {
          "type": ["array", "null"],
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "PDF 좌표. 리뷰 UI에서 원문 하이라이트에 사용."
        },
        "table_ref": { "type": ["string", "null"] }
      }
    },
    "counted": {
      "type": "object",
      "required": ["value", "certainty"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["integer", "null"], "minimum": 0 },
        "certainty": { "type": "string", "enum": ["MEASURED", "ESTIMATED", "UNKNOWN"] },
        "rationale": { "type": "string" },
        "items": {
          "type": "array",
          "description": "MEASURED 인 경우 실제로 센 항목 목록. 이것이 있어야 'DET 14개는 어디서 나왔나'에 답할 수 있다.",
          "items": { "type": "string" }
        }
      }
    }
  }
}
