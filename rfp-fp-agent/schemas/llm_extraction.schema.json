{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal/rfp-fp-agent/llm_extraction.schema.json",
  "title": "RFP FP Agent - LLM 구조화 출력 스키마 v0.3",
  "description": "LLM 은 이 스키마만 만족시키면 된다. FP/복잡도/가중치 필드는 존재하지 않는다 - 계산은 전적으로 Rule Engine 소관이다(설계원칙 1).",
  "type": "object",
  "required": [
    "document_id",
    "chunk_id",
    "model_fingerprint",
    "requirements",
    "function_candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "type": "string"
    },
    "chunk_id": {
      "type": "string",
      "description": "재현성을 위한 입력 청크 식별자"
    },
    "model_fingerprint": {
      "type": "object",
      "description": "결과 재현/회귀 추적용. **필수** — 모델 버전이 바뀌면 산정 결과가 흔들리므로, 지문 없는 산출물은 계약 문서의 근거로 쓸 수 없다.",
      "required": [
        "model",
        "prompt_version",
        "temperature"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "req_id",
          "title",
          "verbatim",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "req_id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "rfp_req_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "RFP 원문에 이미 부여된 요구사항 번호(SFR-001 등). 없으면 null."
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "verbatim": {
            "type": "string",
            "description": "RFP 원문 그대로. 요약/의역 금지. 추적성의 근간."
          },
          "business_area": {
            "type": [
              "string",
              "null"
            ]
          },
          "requirement_class": {
            "type": "string",
            "enum": [
              "FUNCTIONAL",
              "NON_FUNCTIONAL",
              "MANAGEMENT",
              "CONSTRAINT",
              "OUT_OF_SCOPE"
            ],
            "description": "비기능/관리 요구사항은 FP 산정 대상이 아니라 보정계수 입력으로 흘러간다."
          },
          "adjustment_signals": {
            "type": "array",
            "description": "보정계수 산정을 위한 신호(연계기관 수, 성능요건, 보안요건 등)",
            "items": {
              "type": "object",
              "required": [
                "factor",
                "signal",
                "source"
              ],
              "properties": {
                "factor": {
                  "type": "string",
                  "enum": [
                    "연계복잡성",
                    "성능요구수준",
                    "운영환경호환성",
                    "보안성수준",
                    "규모"
                  ]
                },
                "signal": {
                  "type": "string"
                },
                "source": {
                  "$ref": "#/$defs/source"
                }
              }
            }
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "function_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "requirement_ids",
          "name",
          "function_type",
          "evidence",
          "confidence",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "N:M. 요구사항 1건이 여러 기능으로 쪼개지고, 기능 1건이 여러 요구사항에 걸칠 수 있다."
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "function_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ILF",
              "EIF",
              "EI",
              "EO",
              "EQ",
              null
            ],
            "description": "제안 유형. 판정 근거가 부족하면 **null 로 두고 status=INSUFFICIENT_INFO** 로 보고한다. 정보가 없을 때 유형을 추측하도록 강요하지 않는다(설계원칙 4)."
          },
          "function_type_alternatives": {
            "type": "array",
            "description": "2순위 후보와 그 이유. 리뷰어가 EI/EO/EQ 경계 판단을 재검토할 때 사용.",
            "items": {
              "type": "object",
              "required": [
                "function_type",
                "why_not"
              ],
              "properties": {
                "function_type": {
                  "type": "string",
                  "enum": [
                    "ILF",
                    "EIF",
                    "EI",
                    "EO",
                    "EQ"
                  ]
                },
                "why_not": {
                  "type": "string"
                }
              }
            }
          },
          "classification_rationale": {
            "type": "string",
            "minLength": 5,
            "description": "가이드 정의 문구에 근거한 판정 이유. 예: '내부논리파일을 갱신하지 않고 파생데이터 없음 → EQ'"
          },
          "unit_process_check": {
            "type": "object",
            "description": "단위프로세스 요건 충족 여부 자가검증. 미충족이면 FP 대상이 아니다.",
            "required": [
              "is_self_contained",
              "is_meaningful_to_user",
              "leaves_business_consistent"
            ],
            "properties": {
              "is_self_contained": {
                "type": "boolean"
              },
              "is_meaningful_to_user": {
                "type": "boolean"
              },
              "leaves_business_consistent": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "counts": {
            "type": "object",
            "description": "정통법 입력. 모르면 value=null + certainty=UNKNOWN. 절대 지어내지 않는다(원칙 4).",
            "properties": {
              "det": {
                "$ref": "#/$defs/positive_counted"
              },
              "ret": {
                "$ref": "#/$defs/positive_counted"
              },
              "ftr": {
                "$ref": "#/$defs/counted"
              }
            },
            "additionalProperties": false
          },
          "referenced_data_functions": {
            "type": "array",
            "description": "이 트랜잭션이 참조하는 논리파일 이름들. Rule Engine 이 FTR 자동 도출 및 ILF/EIF 정합성 검증에 사용.",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "description": "근거는 필수. 근거 없는 기능은 스키마 단계에서 거부된다(원칙 3).",
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "LLM 자기보고 신뢰도. 리뷰 정렬 용도로만 쓴다. 임계값 기반 자동 승인에 사용하지 않는다 — 캘리브레이션되지 않았다."
          },
          "status": {
            "type": "string",
            "enum": [
              "AI_PROPOSED",
              "NEED_REVIEW",
              "INSUFFICIENT_INFO",
              "OUT_OF_SCOPE_CANDIDATE"
            ]
          },
          "open_questions": {
            "type": "array",
            "minItems": 1,
            "description": "발주자에게 되물어야 할 항목. 그대로 '확인요청 목록' 산출물이 된다.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "duplicate_of": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "function_type": {
                  "type": "string"
                }
              },
              "required": [
                "function_type"
              ]
            },
            "then": {
              "required": [
                "classification_rationale",
                "unit_process_check"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "AI_PROPOSED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "unit_process_check": {
                  "properties": {
                    "is_self_contained": { "const": true },
                    "is_meaningful_to_user": { "const": true },
                    "leaves_business_consistent": { "const": true }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "function_type": {
                  "const": "EQ"
                }
              },
              "required": [
                "function_type"
              ]
            },
            "then": {
              "properties": {
                "counts": {
                  "properties": {
                    "ftr": {
                      "$ref": "#/$defs/positive_counted"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "function_type": {
                  "type": "null"
                }
              },
              "required": [
                "function_type"
              ]
            },
            "then": {
              "properties": {
                "status": {
                  "const": "INSUFFICIENT_INFO"
                }
              },
              "required": [
                "status",
                "open_questions"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "INSUFFICIENT_INFO"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "open_questions"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "page",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "파서가 부여한 원문 블록 ID. 있으면 page보다 우선하여 Evidence를 대조한다."
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "description": "1부터 시작하는 논리 원본 단위. PDF=쪽, PPTX=슬라이드, XLSX=시트 순번, DOCX=블록 순번."
        },
        "source_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "PDF_PAGE",
            "DOCX_SECTION",
            "PPTX_SLIDE",
            "XLSX_SHEET",
            null
          ]
        },
        "slide": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sheet": {
          "type": [
            "string",
            "null"
          ]
        },
        "cell_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 5,
          "description": "원문에 문자 그대로 존재해야 한다. 서비스가 원문 대조로 검증하며, 불일치 시 hallucination 으로 간주하고 거부한다."
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "PDF 좌표. 리뷰 UI에서 원문 하이라이트에 사용."
        },
        "table_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "counted": {
      "type": "object",
      "required": [
        "value",
        "certainty"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "certainty": {
          "type": "string",
          "enum": [
            "MEASURED",
            "ESTIMATED",
            "UNKNOWN"
          ],
          "description": "MEASURED=문서에 명시된 값 / ESTIMATED=추정값 / UNKNOWN=판단 불가(value 는 null). NEEDS_REVIEW 는 시스템이 부여하는 상태이며 LLM 이 출력하지 않는다."
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "description": "MEASURED 인 경우 실제로 센 항목 목록. 이것이 있어야 'DET 14개는 어디서 나왔나'에 답할 수 있다.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "카운트 값 + 확실성. UNKNOWN 은 값을 가질 수 없고, MEASURED 는 센 항목(items)과 근거(rationale)를 반드시 동반해야 한다. 이 제약은 스키마 단계에서 강제된다.",
      "allOf": [
        {
          "if": {
            "properties": {
              "certainty": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "certainty"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "not": {
              "required": [
                "items"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "certainty": {
                "const": "MEASURED"
              }
            },
            "required": [
              "certainty"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0
              },
              "items": {
                "minItems": 1
              }
            },
            "required": [
              "value",
              "items",
              "rationale"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "certainty": {
                "const": "ESTIMATED"
              }
            },
            "required": [
              "certainty"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "value",
              "rationale"
            ]
          }
        }
      ]
    },
    "positive_counted": {
      "allOf": [
        {
          "$ref": "#/$defs/counted"
        },
        {
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
